<script>
  type WakaLanguage = {
    name?: string;
    seconds?: number;
    percent?: number;
  };

  type WakaResponse = {
    languages?: WakaLanguage[];
  };

  const $ = <T extends HTMLElement>(id: string) =>
    document.getElementById(id) as T | null;

  const wakatimeSection = $("wakatime");
  const status = $("status");
  const list = $("list");
  const loadButton = $<HTMLButtonElement>("load");
  if (!wakatimeSection || !status || !list || !loadButton) {
    throw new Error("WakaTime section elements are missing.");
  }

  let statusTimer: number | undefined;
  const setStatus = (text: string, state = "idle") => {
    status.dataset.state = state;
    status.textContent = "";
    clearInterval(statusTimer);
    let i = 0;
    statusTimer = window.setInterval(() => {
      status.textContent += text.charAt(i);
      i += 1;
      if (i >= text.length) clearInterval(statusTimer);
    }, 16);
  };

  const toDateString = (date: Date) => {
    const y = date.getFullYear();
    const m = String(date.getMonth() + 1).padStart(2, "0");
    const d = String(date.getDate()).padStart(2, "0");
    return `${y}-${m}-${d}`;
  };

  const getQueryRange = () => {
    const now = new Date();
    const start = new Date(now.getFullYear(), 11, 1);
    if (now < start) {
      start.setFullYear(start.getFullYear() - 1);
    }
    return {
      start: toDateString(start),
      end: toDateString(now),
    };
  };

  const renderLanguageRows = (languages: WakaLanguage[]) => {
    list.innerHTML = "";
    for (const x of languages) {
      const li = document.createElement("li");
      li.className = "waka-row";
      const rawPct = x.percent ?? 0;
      const pct = Number.isFinite(rawPct)
        ? Math.max(0, Math.min(100, rawPct))
        : 0;
      const langName = x.name ?? "unknown";
      li.innerHTML = `
        <div class="waka-row-head">
          <span class="waka-pct">${pct.toFixed(1)}%</span>
        </div>
        <div class="waka-name-wrap" title="${langName}">
          <span class="waka-name">${langName}</span>
        </div>
        <div class="waka-bar"><span style="width:${pct.toFixed(1)}%"></span></div>
      `;
      list.appendChild(li);
    }
  };

  const loadWakatime = async () => {
    const range = getQueryRange();
    setStatus(`$ loading... (${range.start} -> ${range.end})`, "loading");
    loadButton.disabled = true;
    list.innerHTML = "";

    const base = wakatimeSection.dataset.apiBase?.replace(/\/$/, "") ?? "";
    const url = new URL(`${base}/api/wakatime/languages`);
    url.searchParams.set("start", range.start);
    url.searchParams.set("end", range.end);
    url.searchParams.set("timezone", "Asia/Tokyo");

    try {
      const res = await fetch(url.toString(), {
        headers: { Accept: "application/json" },
      });
      const contentType = res.headers.get("content-type") || "";
      if (!res.ok) {
        throw new Error(`HTTP ${res.status}`);
      }
      if (!contentType.includes("application/json")) {
        throw new Error("Non-JSON response (auth page or server misconfig).");
      }
      const data = (await res.json()) as WakaResponse;
      const langs = Array.isArray(data.languages) ? data.languages : [];
      renderLanguageRows(langs);
      setStatus(
        `$ ${range.start} -> ${range.end} / ${langs.length} languages`,
        "ok",
      );
      if (langs.length === 0) {
        const li = document.createElement("li");
        li.className = "waka-row";
        li.textContent = "No language data in selected range.";
        list.appendChild(li);
      }
    } catch (error: unknown) {
      const message = error instanceof Error ? error.message : "unknown error";
      setStatus(`$ error: ${message}`, "error");
    } finally {
      loadButton.disabled = false;
    }
  };

  loadButton.addEventListener("click", loadWakatime);
  loadWakatime();
</script>

<style>
  #wakatime .waka-button {
