    border-color: rgba(124, 255, 124, 0.55);
  }

  #wakatime .waka-status[data-state="error"] {
    color: #ff9d9d;
    border-color: rgba(255, 105, 105, 0.45);
  }

  #wakatime .waka-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 0.6rem;
  }

  #wakatime .waka-row {
    border: 1px solid rgba(124, 255, 124, 0.45);
    background: rgba(5, 11, 7, 0.88);
    border-radius: 0.5rem;
    padding: 0.75rem 0.8rem;
    box-shadow: inset 0 0 0 1px rgba(124, 255, 124, 0.12);
    animation: waka-fade-in 0.35s ease both;
  }

  #wakatime .waka-row-head {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-bottom: 0.55rem;
    padding-bottom: 0.45rem;
    border-bottom: 1px solid rgba(124, 255, 124, 0.28);
  }

  #wakatime .waka-pct {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 0.18rem 0.5rem;
    border-radius: 999px;
    border: 1px solid rgba(124, 255, 124, 0.3);
    color: var(--page-accent-strong);
    background: rgba(124, 255, 124, 0.1);
  }

  #wakatime .waka-name-wrap {
    min-height: 2.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.5rem;
    padding: 0.25rem 0.2rem 0.55rem;
    border-bottom: 1px solid rgba(124, 255, 124, 0.28);
  }

  #wakatime .waka-name {
    font-size: 1.29rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--page-accent-strong);
    border: 1px solid rgba(124, 255, 124, 0.4);
    border-radius: 0.35rem;
    padding: 0.22rem 0.5rem;
    background: rgba(124, 255, 124, 0.12);
    max-width: 100%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  #wakatime .waka-row-sub {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 0.5rem;
    padding-bottom: 0.45rem;
    border-bottom: 1px solid rgba(124, 255, 124, 0.28);
  }

  #wakatime .waka-meta {
    font-size: 0.78rem;
    color: var(--page-muted);
  }

  #wakatime .waka-bar {
    width: 100%;
    height: 0.5rem;
    border-radius: 999px;
    background: rgba(124, 255, 124, 0.14);
    overflow: hidden;
  }

  #wakatime .waka-bar > span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(
      90deg,
      rgba(124, 255, 124, 0.45),
      rgba(198, 255, 162, 0.95)
    );
    box-shadow: 0 0 10px rgba(124, 255, 124, 0.35);
  }

  @media (max-width: 520px) {
    #wakatime .waka-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.5rem;
    }

    #wakatime .waka-row-sub {
      justify-content: flex-end;
    }
  }

  @keyframes waka-fade-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
